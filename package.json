{
  "name": "obsidian-canvas-comments",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymous threaded comments for Obsidian Canvas elements and text selections.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kairosgold/canvas-comments.git"
  },
  "bugs": {
    "url": "https://github.com/kairosgold/canvas-comments/issues"
  },
  "homepage": "https://github.com/kairosgold/canvas-comments#readme",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.ts --bundle --external:obsidian --external:@codemirror/state --external:@codemirror/view --format=cjs --target=es2018 --minify --outfile=main.js",
    "dev": "npm run build -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.13.1",
    "typescript": "^5.9.0"
  }
}
